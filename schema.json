{
  "type": "object",
  "properties": {
    "$schema": {
      "description": "供编辑器使用的 JSON Schema 地址，支持相对路径",
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "description": "模板名称"
    },
    "description": {
      "type": "string",
      "description": "模板描述"
    },
    "tar": {
      "type": "string",
      "format": "uri",
      "description": "模板 tar.gz 压缩包的下载地址"
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "模板仓库或介绍页面的地址"
    },
    "version": {
      "description": "模板版本标识",
      "type": "string"
    },
    "repo": {
      "type": "string",
      "description": "模板 Github 仓库名称"
    },
    "defaultDir": {
      "type": "string",
      "description": "模板默认克隆文件夹名称"
    }
  },
  "required": [
    "name",
    "description",
    "tar",
    "url",
    "repo",
    "defaultDir"
  ],
  "additionalProperties": {},
  "title": "Giget Template Registry Entry",
  "description": "giget 自定义注册表中的单个模板定义"
}
